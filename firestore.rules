rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to securely check if the user is a real Admin
    function isAdmin() {
      return request.auth != null && 
             exists(/databases/$(database)/documents/settings/admins) &&
             request.auth.token.email in get(/databases/$(database)/documents/settings/admins).data.emails;
    }

    // 1. Products: 
    // - Anyone can read
    // - Admins can do anything
    // - Customers can only update the 'stock' field to decrease it when they buy.
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.auth != null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock']) &&
        request.resource.data.stock < resource.data.stock
      );
      
      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        // Authenticated users can create reviews, admins can delete
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update, delete: if isAdmin();
      }
    }

    // 2. Settings (Banners, Admin list): Anyone can view, ONLY Admins can edit
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 3. Users: Customers can ONLY see and edit their OWN data
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // 4. Orders: 
    // - Customers can create orders for themselves
    // - Customers can read their own receipts
    // - Customers can update their own order to add a transactionId and change status
    // - Admins have full access to read, update, and manage all orders
    match /orders/{orderId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow read: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      allow update: if isAdmin() || (
        request.auth != null && 
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'transactionId'])
      );
      allow delete: if isAdmin(); 
    }
  }
}
